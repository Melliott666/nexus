# VERBOSITY
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

# GENERATION
/Generator/SingleParticle/particle alpha
/Generator/SingleParticle/min_energy 5 MeV
/Generator/SingleParticle/max_energy 5 MeV
/Generator/SingleParticle/region AD_HOC
/Generator/SingleParticle/momentum 0 0 1

# Nexus Physics List
/PhysicsList/Nexus/clustering           true
/PhysicsList/Nexus/drift                true
/PhysicsList/Nexus/electroluminescence  true

# GEOMETRY
/Geometry/KingCRAB/gas_pressure 5 bar
/Geometry/KingCRAB/max_step_size 0.5 mm
/Geometry/KingCRAB/specific_vertex_ 0 0 8.5 mm
/Geometry/KingCRAB/EL_field_intensity 900 kV/m

# FRESNEL-REFLECTION HYPOTHESIS TEST
# Remove photons that Fresnel-reflect at either fused-silica lens. Store only
# crossings into the absorbing image-intensifier disk, then stop those photons.
# Compare this output with an otherwise identical run using `false` below.
/Actions/SaveAllSteppingAction/select_particle opticalphoton
/Actions/SaveAllSteppingAction/select_volume Image-Intensifier
/Actions/SaveAllSteppingAction/kill_lens_fresnel_reflections true
/Actions/SaveAllSteppingAction/kill_after_selection true

# PERSISTENCY
/nexus/random_seed            9
/nexus/persistency/start_id   0
/nexus/persistency/output_file KingCRAB_AlphaTracks_NoLensFresnel
# Detector hits are in /DEBUG/steps; the enormous all-photon /MC/particles
# table is deliberately disabled.
/nexus/persistency/save_particles false
