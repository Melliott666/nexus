# VERBOSITY
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

# GENERATION
/Generator/SingleParticle/particle alpha
/Generator/SingleParticle/min_energy 5 MeV
/Generator/SingleParticle/max_energy 5 MeV
/Generator/SingleParticle/region AD_HOC
/Generator/SingleParticle/momentum 0 0 1

# Nexus Physics List
/PhysicsList/Nexus/clustering           true
/PhysicsList/Nexus/drift                true
/PhysicsList/Nexus/electroluminescence  true

# GEOMETRY
/Geometry/KingCRAB/gas_pressure 5 bar
/Geometry/KingCRAB/max_step_size 0.5 mm
/Geometry/KingCRAB/specific_vertex_ 0 0 8.5 mm
/Geometry/KingCRAB/EL_field_intensity 900 kV/m

# FOCAL-SCAN MODE
# Store optical-photon steps through the transparent z-depth cylinder. Do not
# stop selected photons, because the analysis interpolates their trajectories
# across all requested virtual image planes. Keep the current lens Fresnel
# filter enabled so this scan matches the latest no-Fresnel detector test.
/Actions/SaveAllSteppingAction/select_particle opticalphoton
/Actions/SaveAllSteppingAction/select_volume FOCAL_SCAN
# Save only sparse optical checkpoints needed to reconstruct the route of
# photons later identified in the curved image. Avoid selecting GAS/EL_GAP,
# which would restore the prohibitive all-photon output volume.
/Actions/SaveAllSteppingAction/select_volume FS_LENS
/Actions/SaveAllSteppingAction/select_volume Image-Intensifier-FS-Lens
/Actions/SaveAllSteppingAction/select_volume MIRROR
/Actions/SaveAllSteppingAction/kill_lens_fresnel_reflections true
/Actions/SaveAllSteppingAction/kill_after_selection false
# Record where photons die only after they have touched one of the selected
# optical components. This avoids saving terminal rows for the enormous number
# of isotropic photons that never enter the imaging system.
/Actions/SaveAllSteppingAction/record_selected_track_deaths true

# PERSISTENCY
/nexus/random_seed            9
/nexus/persistency/start_id   0
/nexus/persistency/output_file KingCRAB_AlphaTracks_OpticalDiagnostic_LargeCylinder
# Focal-cylinder crossings are in /DEBUG/steps; the enormous all-photon
# /MC/particles table is deliberately disabled.
/nexus/persistency/save_particles false
