## ----------------------------------------------------------------------------
## nexus | KingCRAB_Ba133DirectRate.init.mac
##
## Initialization macro for the King CRAB Ba-133 direct-light rate study
##
## The NEXT Collaboration
## ----------------------------------------------------------------------------

/PhysicsList/RegisterPhysics G4EmStandardPhysics_option4
/PhysicsList/RegisterPhysics G4DecayPhysics
/PhysicsList/RegisterPhysics G4RadioactiveDecayPhysics
/PhysicsList/RegisterPhysics NexusPhysics
/PhysicsList/RegisterPhysics G4StepLimiterPhysics
/PhysicsList/RegisterPhysics G4OpticalPhysics

/nexus/RegisterGeometry KingCRAB
/nexus/RegisterGenerator SingleParticleGenerator
/nexus/RegisterPersistencyManager PersistencyManager
/nexus/RegisterRunAction DefaultRunAction

# Do not persist optical trajectories. The stepping action stores only the
# first crossing of the one-inch direct-light scoring plane.
/nexus/RegisterTrackingAction DefaultTrackingAction
/nexus/RegisterSteppingAction SaveAllSteppingAction

/nexus/RegisterMacro macros/KingCRAB_Ba133DirectRate.config.mac
/nexus/RegisterDelayedMacro macros/KingCRAB_Ba133DirectRate.physics.mac
