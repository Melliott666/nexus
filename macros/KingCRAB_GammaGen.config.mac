## ----------------------------------------------------------------------------
## nexus | KingCRAB_GammaGen.config.mac
##
## Configuration macro to simulate complete Ba-133 decays in KingCRAB.
##
## The primary is a neutral Ba-133 ion. G4RadioactiveDecayPhysics samples the
## electron-capture branch and the subsequent Cs-133 nuclear-level cascade for
## every event, including gamma emission, internal conversion and atomic
## relaxation products. IonGenerator shortens only the parent waiting time;
## it does not alter any branching fractions or emitted-particle energies.
##
## The NEXT Collaboration
## ----------------------------------------------------------------------------

# VERBOSITY
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

# GENERATION: Eu152 (Z=63, A=152), ground state
/Generator/IonGenerator/region AD_HOC
/Generator/IonGenerator/atomic_number 63
/Generator/IonGenerator/mass_number 152
/Generator/IonGenerator/energy_level 0 MeV
/Generator/IonGenerator/decay_at_time_zero true
/Geometry/KingCRAB/specific_vertex_ -82.55 143.002 1250 mm
# Field off
/Geometry/KingCRAB/EL_field_intensity 0 kV/m

## Nexus Physics List
/PhysicsList/Nexus/clustering           true
/PhysicsList/Nexus/drift                true
/PhysicsList/Nexus/electroluminescence  true

#GEOMETRY
/Geometry/KingCRAB/gastype argon
/Geometry/KingCRAB/gas_pressure 1. bar
/Geometry/KingCRAB/max_step_size 1 mm
/Geometry/KingCRAB/direct_light_search true

# Record and stop optical photons at the ideal one-inch direct-light plane.
/Actions/SaveAllSteppingAction/select_particle opticalphoton
/Actions/SaveAllSteppingAction/select_volume II_ONE_INCH_SCORE
/Actions/SaveAllSteppingAction/kill_after_selection true

# PERSISTENCY
/nexus/random_seed            9
/nexus/persistency/start_id   0
/nexus/persistency/output_file KingCRAB_EuGen_FieldOff
